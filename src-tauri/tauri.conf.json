{
  "productName": "noshRadio",
  "version": "1.0.1",
  "identifier": "com.noshradio.app",
  "build": {
    "frontendDist": "../web",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "node dev-server.js",
    "beforeBuildCommand": "if not exist ..\\web mkdir ..\\web && if not exist ..\\web\\lib mkdir ..\\web\\lib && if not exist ..\\web\\fonts mkdir ..\\web\\fonts && copy /Y ..\\nosh-music-ai.html ..\\web\\ && copy /Y ..\\nosh-taste.js ..\\web\\ && copy /Y ..\\nosh-persist.js ..\\web\\ && copy /Y ..\\nosh-avatar.png ..\\web\\ && copy /Y ..\\lib\\* ..\\web\\lib\\ && copy /Y ..\\fonts\\* ..\\web\\fonts\\ && cd .. && node scripts\\build-services.js"
  },
  "app": {
    "windows": [
      {
        "title": "NOSH RADIO",
        "width": 1400,
        "height": 850,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "url": "nosh-music-ai.html",
        "additionalBrowserArgs": "--ignore-gpu-blocklist --enable-zero-copy --enable-accelerated-2d-canvas --disable-background-timer-throttling --disable-renderer-backgrounding"
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "resources": [
      "../proxy-server.js",
      "../build/bundled/**/*",
      "../nosh-taste.js",
      "../nosh-persist.js",
      "../lib/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": null,
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "../src-tauri/icons/icon.ico",
        "uninstallerIcon": "../src-tauri/icons/icon.ico",
        "headerImage": "../build/installer-header.bmp",
        "sidebarImage": "../build/installer-sidebar.bmp",
        "uninstallerHeaderImage": "../build/installer-header.bmp"
      }
    }
  },
  "plugins": {
    "updater": {
      "active": false,
      "endpoints": [],
      "dialog": true,
      "pubkey": ""
    }
  }
}
